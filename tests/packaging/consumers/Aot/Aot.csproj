<Project Sdk="Microsoft.NET.Sdk">
  <!-- Consumes the packed DotNetMapper, never the project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Any IL2xxx/IL3xxx warning from the package fails the publish. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotNetMapper" Version="$(DotNetMapperVersion)" />
    <TrimmerRootAssembly Include="DotNetMapper" />
  </ItemGroup>
</Project>
