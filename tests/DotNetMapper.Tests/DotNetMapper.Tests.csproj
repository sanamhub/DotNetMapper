<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Project references do not get the package's buildTransitive props, so opt in here. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);DotNetMapper.Generated</InterceptorsNamespaces>
    <!-- Lets a reviewer read what the generator produced under obj/. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <TestingPlatformCommandLineArguments>--minimum-expected-tests 28</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetMapper\DotNetMapper.csproj" />
    <ProjectReference Include="..\..\src\DotNetMapper.Generator\DotNetMapper.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
